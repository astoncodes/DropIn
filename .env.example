# Copy to .env and fill in. NEVER commit .env — see .gitignore.
#
# SECURITY BOUNDARY (docs/architecture.md §Access control):
#   EXPO_PUBLIC_* and VITE_* are compiled into client bundles and are readable
#   by anyone who installs the app or opens devtools. Only ever put the
#   publishable/anon key there — it is safe precisely because Row Level Security
#   constrains what it can do.
#   The service-role key and the database password MUST NOT appear in either
#   prefix, in any committed file, or in a test snapshot.

# ---------------------------------------------------------------------------
# Client-side (safe to ship in a bundle, constrained by RLS)
# ---------------------------------------------------------------------------

# Hosted Supabase project URL and publishable key from the dashboard.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Geoapify location search. Public key; apply provider restrictions.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Mapbox public access token (pk.*), used by native and web maps.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Sign-In. Web client ID (used on both platforms to get a verifiable
# ID token) and iOS client ID from Google Cloud Console > APIs & Services >
# Credentials. Register both as OAuth 2.0 Client IDs, and register the Web
# client ID as the Google provider's client ID in the Supabase dashboard.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The iOS client ID's segments reversed and dot-joined, e.g. an iOS client ID
# of 123-abc.apps.googleusercontent.com becomes
# com.googleusercontent.apps.123-abc. Google Cloud Console shows this exact
# value on the iOS OAuth client's detail page.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Public support contact, shown in the app, the privacy policy and the terms.
# Required for production builds (app.config.ts refuses to build without it).
EXPO_PUBLIC_SUPPORT_EMAIL=
# Who operates Drop In — a person or company name — as named in the privacy
# policy and terms. Optional; the documents say "the Drop In team" without it.
EXPO_PUBLIC_OPERATOR_NAME=
# Public web address where the web build is hosted, without a trailing slash,
# e.g. https://playdropin.app. Used to print the account-deletion web address.
EXPO_PUBLIC_SITE_URL=

# Admin review app — Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only (never reaches a browser or device)
# ---------------------------------------------------------------------------

# Admin maintenance — connects directly to Postgres as a privileged dev user.
# Hosted connection string from Supabase Connect; used only for privileged tools.
SUPABASE_DB_URL=

# Optional CLI / isolated database testing. Never use the app project for db:test.
SUPABASE_PROJECT_REF=
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_DB_URL=

# The app project's secret key (dashboard → Project settings → API keys; starts
# with "sb_secret_"). The hosted end-to-end scripts in scripts/tests use it to
# create and remove temporary accounts. It opens this one project only. Never a
# client value.
SUPABASE_SECRET_KEY=

# Supabase personal access token (dashboard → Account → Access Tokens; starts
# with "sbp_"). Used by `npm run db:types` in CI, and by the hosted scripts to
# look the secret key up when it is not set above. It reaches every project in
# the account. Never a client value.
SUPABASE_ACCESS_TOKEN=

# For explicit development commands, see .env.dev.example and docs/development.md.

# Edge Function secret: exact comma-separated HTTPS browser origins, no paths.
# Set in Supabase before deploying delete-account for web clients. Empty denies
# browser origins while native requests still require authentication.
ALLOWED_WEB_ORIGINS=
