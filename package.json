{
  "name": "drop-in",
  "version": "0.1.0",
  "private": true,
  "description": "Drop In — pickup sports check-in app — find where games are happening now, check in while you're there.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:js && npm run test:tooling",
    "test:js": "npm run test --workspaces --if-present",
    "test:tooling": "node scripts/tests/account-deletion-handler.mjs && node scripts/test-database.mjs --self-test && node scripts/check-client-bundles.mjs --self-test",
    "db:test": "node scripts/test-database.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:admin": "node scripts/grant-admin.mjs",
    "build": "npm run build --workspaces --if-present",
    "check:bundles": "npm run build && node scripts/check-client-bundles.mjs",
    "mobile": "npm run start --workspace apps/mobile",
    "ios": "npm run ios --workspace apps/mobile",
    "ios:sim": "node scripts/run-ios-simulator.mjs",
    "android": "npm run android --workspace apps/mobile",
    "admin": "npm run dev --workspace apps/admin",
    "test:supabase": "node scripts/tests/session-social.mjs",
    "test:maps": "npm run test --workspace apps/mobile -- tests/geoapify.test.ts tests/location-distance.test.ts",
    "test:browser": "node scripts/tests/browser-public.mjs",
    "test:browser:supabase": "node scripts/tests/browser-social.mjs",
    "test:browser:venues": "node scripts/tests/browser-venue-review.mjs",
    "test:browser:location": "node scripts/tests/browser-location-gate.mjs",
    "test:presence": "node scripts/tests/live-presence.mjs"
  },
  "devDependencies": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "supabase": "^2.114.0",
    "typescript": "~6.0.3"
  }
}
